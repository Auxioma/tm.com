<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers et dossiers existants : servis directement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres routes -> index.html (react-router)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Les assets Vite sont hashés : cache long
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # index.html jamais mis en cache, pour récupérer les nouveaux builds
  <FilesMatch "index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>
